rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Anyone can view uploaded photos/video.
      allow read: if true;
      // Only signed-in admins (present in the Firestore "admins" collection)
      // can upload or replace files.
      allow write: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email));
    }
  }
}
